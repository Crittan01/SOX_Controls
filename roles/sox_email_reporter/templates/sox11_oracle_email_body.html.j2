<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <style>
    {% include 'partials/email_styles.j2' %}
  </style>
</head>

<body>
  <div class="container">
    <div class="header">
      <h2 style="margin: 0;">{{ email_subject }}</h2>
    </div>

    {# Banner de estado #}
    {% if email_data.statistics.databases_failed | int > 0 %}
    <div class="alert">
      Se detectaron {{ email_data.statistics.databases_failed }} base(s) con errores de conexión
    </div>
    {% elif email_data.statistics.total_users_blocked | int > 0 %}
    <div class="alert">
      Se detectaron {{ email_data.statistics.total_users_blocked }} usuarios bloqueados en el período
    </div>
    {% else %}
    <div class="success">
      No se detectaron usuarios bloqueados en el período auditado
    </div>
    {% endif %}

    <p>Estimado equipo de Auditoría,</p>

    <p>Adjunto encontrará el resultado del control <strong>{{ email_subject }}</strong> ejecutado el <strong>{{ email_data.metadata.execution_date }} a las {{ email_data.metadata.execution_time }}</strong>.</p>

    {# Información del Control SOX #}
    <div class="info-box">
      <p><strong>Información del Control:</strong></p>
      <ul style="margin: 10px 0; padding-left: 20px;">
        <li><strong>Control ID:</strong> {{ email_data.metadata.control_id }}</li>
        <li><strong>Control:</strong> {{ email_data.metadata.control_name }}</li>
        <li><strong>Descripción:</strong> {{ email_data.metadata.control_description }}</li>
        <li><strong>Procedure Original:</strong> {{ email_data.metadata.procedure_original }}</li>
        <li><strong>Fecha de Ejecución:</strong> {{ email_data.metadata.execution_date }} {{ email_data.metadata.execution_time }}</li>
        <li><strong>Job ID (AAP):</strong> {% if email_data.metadata.aap_job_id != 'localmente_no_AAP' %}<a href="{{ email_data.metadata.aap_job_url }}">{{ email_data.metadata.aap_job_id }}</a>{% else %}{{ email_data.metadata.aap_job_id }}{% endif %}</li>
        <li><strong>Usuario Ejecutor:</strong> {{ email_data.metadata.aap_executor }}</li>
      </ul>
    </div>

    {# ═══════════════════════════════════════════════════════════════ #}
    {# EVIDENCIA DE INTEGRIDAD (COMPLETA) #}
    {# ═══════════════════════════════════════════════════════════════ #}
    <div class="info-box" style="border-left: 4px solid #0066cc;">
      <p><strong>EVIDENCIA DE INTEGRIDAD (SOX Compliance):</strong></p>
      <table style="margin: 10px 0;">
        <tr>
          <th style="text-align: left; width: 40%;">Componente</th>
          <th style="text-align: left;">Valor</th>
        </tr>
        <tr>
          <td><strong>Archivo SQL Ejecutado:</strong></td>
          <td><code>{{ email_data.metadata.sql_file_name }}</code></td>
        </tr>
        <tr style="background-color: #fffacd;">
          <td><strong>SHA256 Hash (Evidencia):</strong></td>
          <td><code style="font-size: 11px;">{{ email_data.metadata.sql_file_sha256 }}</code></td>
        </tr>
        <tr>
          <td><strong>Última Modificación SQL:</strong></td>
          <td>{{ email_data.metadata.sql_file_last_modified }}</td>
        </tr>
        <tr>
          <td><strong>Tamaño del Archivo:</strong></td>
          <td>{{ email_data.metadata.sql_file_size_bytes }} bytes</td>
        </tr>
        <tr>
          <td colspan="2" style="height: 10px;"></td>
        </tr>
        <tr>
          <td><strong>Git Project Revision:</strong></td>
          <td><code>{{ email_data.metadata.aap_project_revision }}</code></td>
        </tr>
        <tr>
          <td><strong>AAP Job Template:</strong></td>
          <td>{{ email_data.metadata.aap_job_template }}</td>
        </tr>
        <tr>
          <td><strong>Ansible Version:</strong></td>
          <td>{{ email_data.metadata.ansible_version }}</td>
        </tr>
        <tr>
          <td><strong>Role Version:</strong></td>
          <td>{{ email_data.metadata.role_version }}</td>
        </tr>
      </table>
      <p style="font-size: 11px; color: #666; margin-top: 10px; background-color: #f8f9fa; padding: 10px; border-left: 3px solid #0066cc;">
        <strong>IMPORTANTE PARA AUDITORÍA:</strong><br>
        El hash SHA256 del archivo SQL ejecutado es <strong>{{ email_data.metadata.sql_file_sha256 }}</strong>. 
        Este hash permite verificar que el query no fue modificado desde su última auditoría. 
        Para validar la integridad, ejecute: <code>sha256sum {{ email_data.metadata.sql_file_name }}</code>
      </p>
    </div>

    {# Estadísticas Globales #}
    <div class="info-box">
      <p><strong>Resumen de Ejecución:</strong></p>
      <div class="stats-grid">
        <div class="stat-item">
          <div class="stat-value">{{ email_data.statistics.total_databases }}</div>
          <div class="stat-label">Bases Oracle</div>
        </div>
        <div class="stat-item">
          <div class="stat-value context-ok">{{ email_data.statistics.databases_processed }}</div>
          <div class="stat-label">Procesadas OK</div>
        </div>
        <div class="stat-item">
          <div class="stat-value {% if email_data.statistics.total_users_blocked | int > 0 %}context-alert{% endif %}">{{ email_data.statistics.total_users_blocked }}</div>
          <div class="stat-label">Usuarios Bloqueados</div>
        </div>
        <div class="stat-item">
          <div class="stat-value context-ok">{{ email_data.statistics.records_inserted_audit }}</div>
          <div class="stat-label">Registros Auditoría</div>
        </div>
      </div>
    </div>

    {# Detalle de Usuarios Bloqueados #}
    {% if email_data.statistics.total_users_blocked | int > 0 %}
    <div class="info-box">
      <p><strong>Detalle de Usuarios Bloqueados (Mes Anterior):</strong></p>
      <table>
        <thead>
          <tr>
            <th>Usuario</th>
            <th>Estado</th>
            <th>Perfil</th>
            <th>Fecha Creación</th>
            <th>Fecha Bloqueo</th>
            <th>Fecha Expiración</th>
          </tr>
        </thead>
        <tbody>
          {% for user in email_data.users[:10] %}
          <tr>
            <td><strong>{{ user.username }}</strong></td>
            <td class="{{ 'context-alert' if 'LOCKED' in user.account_status else 'context-error' }}">
              {{ user.account_status }}
            </td>
            <td>{{ user.profile }}</td>
            <td style="font-size: 11px;">{{ user.created }}</td>
            <td style="font-size: 11px;">{{ user.lock_date }}</td>
            <td style="font-size: 11px;">{{ user.expiry_date if user.expiry_date and user.expiry_date != 'N/A' else 'N/A' }}</td>
          </tr>
          {% endfor %}
          {% if email_data.users | length > 10 %}
          <tr>
            <td colspan="6" style="text-align: center; background-color: #fff3cd; font-style: italic; padding: 10px;">
              ... y {{ email_data.users | length - 10 }} usuarios adicionales (consultar base de auditoría: {{ email_data.statistics.audit_table_name }} o adjunto Excel)
            </td>
          </tr>
          {% endif %}
        </tbody>
      </table>
    </div>

    {# Estadísticas por Estado #}
    <div class="info-box">
      <p><strong>Distribución por Estado de Cuenta:</strong></p>
      <div class="stats-grid">
        <div class="stat-item">
          <div class="stat-value context-alert">{{ email_data.statistics.users_locked }}</div>
          <div class="stat-label">LOCKED</div>
        </div>
        <div class="stat-item">
          <div class="stat-value context-error">{{ email_data.statistics.users_expired }}</div>
          <div class="stat-label">EXPIRED</div>
        </div>
        <div class="stat-item">
          <div class="stat-value context-error">{{ email_data.statistics.users_locked_and_expired }}</div>
          <div class="stat-label">LOCKED Y EXPIRED</div>
        </div>
      </div>
    </div>
    {% endif %}

    {# Bases con Errores #}
    {% if email_data.databases_errors | length > 0 %}
    <div class="alert">
      <p><strong>Bases de Datos con Errores de Conexión:</strong></p>
      <table style="font-size: 11px;">
        <thead>
          <tr>
            <th>Base de Datos</th>
            <th>Host</th>
            <th>Error</th>
          </tr>
        </thead>
        <tbody>
          {% for db_error in email_data.databases_errors %}
          <tr>
            <td><strong>{{ db_error.database_name }}</strong></td>
            <td>{{ db_error.database_host }}</td>
            <td style="text-align: left;">{{ db_error.error_message | truncate(80) }}</td>
          </tr>
          {% endfor %}
        </tbody>
      </table>
      <p style="font-size: 11px; margin-top: 10px;">
        <em>Verificar conectividad y credenciales. Los registros de las bases exitosas fueron insertados en auditoría.</em>
      </p>
    </div>
    {% else %}
    <div class="success">
      Todas las bases de datos fueron procesadas exitosamente
    </div>
    {% endif %}

    {# ═══════════════════════════════════════════════════════════════ #}
    {# BASES EXITOSAS (LISTA CONDENSADA) - FALTABA ESTO #}
    {# ═══════════════════════════════════════════════════════════════ #}
    {% if email_data.databases_success | length > 0 %}
    <div class="info-box">
      <p><strong>Registros encontrados en las siguientes Bases de Datos ({{ email_data.databases_success | length }}):</strong></p>
      <p style="font-size: 11px; color: #666;">
        {{ email_data.databases_success | join(', ') }}
      </p>
    </div>
    {% endif %}

    {# Trazabilidad #}
    <div class="info-box">
      <p><strong>Trazabilidad y Auditoría:</strong></p>
      <ul style="margin: 10px 0; padding-left: 20px; font-size: 12px;">
        <li>Registros históricos almacenados en: <code>{{ email_data.statistics.audit_table_name }}</code></li>
        <li>Período auditado: Mes anterior completo (usuarios bloqueados entre primer y último día del mes)</li>
        <li>Query ejecutado: <code>{{ email_data.metadata.sql_file_name }}</code> (SHA256: <code style="font-size: 10px;">{{ email_data.metadata.sql_file_sha256 }}</code>)</li>
        {% if email_data.metadata.aap_job_id != 'localmente_no_AAP' %}<li>Para auditar ejecución completa: <a href="{{ email_data.metadata.aap_job_url }}">Ver Job {{ email_data.metadata.aap_job_id }} en AAP</a></li>{% else %}<li>Ejecución local (no disponible en AAP)</li>{% endif %}
      </ul>
    </div>

    {# Query Ejecutado (expandible) #}
    <div class="info-box" style="background-color: #f0f0f0;">
      <p><strong>Query SQL Ejecutado:</strong></p>
      <pre style="background-color: #fff; padding: 10px; border: 1px solid #ccc; overflow-x: auto; font-size: 10px; max-height: 300px;">{{ email_data.metadata.query_executed }}</pre>
      <p style="font-size: 10px; color: #666; margin-top: 5px;">
        <em>Este es el query exacto ejecutado en todas las bases Oracle. El hash SHA256 de este archivo es: {{ email_data.metadata.sql_file_sha256 }}</em>
      </p>
    </div>

    <p style="margin-top: 20px;">Este control SOX ha sido migrado desde <strong>Stored Procedures SQL</strong> a <strong>Ansible Automation Platform</strong> siguiendo mejores prácticas de infraestructura como código y eliminando el uso de DB Links.</p>

    <div class="footer">
      <p>Este es un correo automático, por favor no responder</p>
      <p class="team-name">{{ team_name | default('Equipo de Automatización') }}</p>
      <p style="margin-top: 5px;">
        Generado por: Ansible Automation Platform | 
        Role Version: {{ email_data.metadata.role_version }} | 
        Project: {{ email_data.metadata.aap_project_revision }}
      </p>
      <p style="margin-top: 5px; font-size: 10px;">
        Evidencia: SHA256 {{ email_data.metadata.sql_file_sha256 }} | 
        Job: {% if email_data.metadata.aap_job_id != 'localmente_no_AAP' %}<a href="{{ email_data.metadata.aap_job_url }}">{{ email_data.metadata.aap_job_id }}</a>{% else %}{{ email_data.metadata.aap_job_id }}{% endif %}
      </p>
    </div>
  </div>
</body>
</html>